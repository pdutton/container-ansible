FROM docker.io/library/ubuntu:26.04

LABEL org.opencontainers.image.title="ansible" \
      org.opencontainers.image.description="Ansible 13 (stable) on Ubuntu 26.04, from distro packages" \
      org.opencontainers.image.licenses="GPL-3.0-or-later" \
      org.opencontainers.image.source="https://github.com/pdutton/container-ansible" \
      org.opencontainers.image.url="https://github.com/pdutton/container-ansible" \
      org.opencontainers.image.vendor="pdutton" \
      org.opencontainers.image.base.name="docker.io/library/ubuntu:26.04"

# --no-install-recommends plus an explicit list: keeps the functional packages
# apt would recommend, drops X11/Sphinx/Babel ballast a container never uses.
#
# Ubuntu packages no pypsrp (PSRP connection plugin), requests-credssp, or krb5,
# so those three alone come from pip, under /usr/local. --no-deps keeps pip from
# installing a newer copy of any apt-owned dependency (pyspnego, gssapi,
# cryptography, requests) into /usr/local, where it would silently shadow the
# apt one.
#
# krb5 is what gives PSRP Kerberos: pyspnego's Kerberos backend needs both
# gssapi and krb5, and krb5 publishes no Linux wheels, so it is compiled here.
# pip and the compiler toolchain are installed only for this step and purged in
# the same layer. krb5-user provides kinit/klist (also what the winrm plugin's
# managed kinit runs); mount your own /etc/krb5.conf at runtime.
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      ansible \
      openssh-client \
      sshpass \
      python3-jmespath \
      python3-passlib \
      python3-xmltodict \
      python3-selinux \
      python3-winrm \
      python3-pyspnego \
      python3-requests-ntlm \
      python3-kerberos \
      python3-gssapi \
      python3-requests \
      python3-argcomplete \
      krb5-user \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      python3-pip gcc libc6-dev libkrb5-dev python3-dev \
 && pip install --no-cache-dir --break-system-packages \
      --no-deps \
      "pypsrp>=0.4,<1" \
      "requests-credssp>=2" \
      "krb5>=0.3" \
 && apt-get purge -y --auto-remove python3-pip gcc libc6-dev libkrb5-dev python3-dev \
 && rm -rf /var/lib/apt/lists/*

# pdutton.xplat, tracking its master branch. It has no Galaxy release, so it
# comes from git, which is added for this step only. The Makefile resolves
# master to a commit SHA and passes it as XPLAT_REF, so a new xplat commit
# invalidates this layer and nothing above it; the default only serves a bare
# `podman build`. The label records which commit went in, since galaxy.yml's
# version is not bumped on every commit. --no-deps is load-bearing: xplat
# declares community.general, and resolving it would put a Galaxy copy in
# /usr/share/ansible/collections that shadows the one in the ansible bundle.
# ansible-galaxy leaves a galaxy_cache and tmp dir in /root/.ansible, which no
# earlier layer creates, so the whole directory goes.
ARG XPLAT_REF=master
LABEL io.github.pdutton.xplat.revision="$XPLAT_REF"
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends git \
 && ansible-galaxy collection install --no-deps \
      -p /usr/share/ansible/collections \
      "git+https://github.com/pdutton/ansible-collection-xplat.git,$XPLAT_REF" \
 && apt-get purge -y --auto-remove git \
 && rm -rf /root/.ansible /var/lib/apt/lists/*

WORKDIR /apps
CMD ["ansible", "--help"]
