FROM docker.io/library/ubuntu:26.04

LABEL org.opencontainers.image.title="ansible" \
      org.opencontainers.image.description="Ansible 14 (development) on Ubuntu 26.04, from pip" \
      org.opencontainers.image.licenses="GPL-3.0-or-later" \
      org.opencontainers.image.source="https://github.com/pdutton/container-ansible" \
      org.opencontainers.image.url="https://github.com/pdutton/container-ansible" \
      org.opencontainers.image.vendor="pdutton" \
      org.opencontainers.image.base.name="docker.io/library/ubuntu:26.04"

# System Python is PEP 668 externally-managed, so Ansible goes in a venv.
# Ubuntu ships no Ansible 14 in any suite, so pip is required here. The venv is
# created with --system-site-packages so it can see the apt-installed
# winrm/kerberos/gssapi/selinux stack below, giving this variant the same
# Windows/Kerberos/SELinux capability as ubuntu-stable -- selinux in particular
# has no usable PyPI equivalent. Only Ansible, pypsrp (PSRP connection plugin)
# and its requests-credssp/krb5 extras -- none of which Ubuntu packages -- come
# from pip; pypsrp's pyspnego and gssapi are the apt ones.
#
# krb5 is what gives PSRP Kerberos: pyspnego's Kerberos backend needs both
# gssapi and krb5, and krb5 publishes no Linux wheels, so it is compiled here.
# The compiler toolchain is installed only for this step and purged in the same
# layer. krb5-user provides kinit/klist (also what the winrm plugin's managed
# kinit runs); mount your own /etc/krb5.conf at runtime.
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      python3 \
      python3-pip \
      python3-venv \
      openssh-client \
      sshpass \
      python3-winrm \
      python3-pyspnego \
      python3-requests-ntlm \
      python3-kerberos \
      python3-gssapi \
      python3-selinux \
      krb5-user \
      gcc libc6-dev libkrb5-dev python3-dev \
 && python3 -m venv --system-site-packages /opt/ansible \
 && /opt/ansible/bin/pip install --no-cache-dir \
      "ansible>=14,<15" \
      jmespath \
      passlib \
      xmltodict \
      requests \
      argcomplete \
      "pypsrp[credssp,kerberos]>=0.4,<1" \
 && apt-get purge -y --auto-remove gcc libc6-dev libkrb5-dev python3-dev \
 && rm -rf /var/lib/apt/lists/*

ENV PATH="/opt/ansible/bin:$PATH"

# pdutton.xplat, tracking its master branch. It has no Galaxy release, so it
# comes from git, which is added for this step only. The Makefile resolves
# master to a commit SHA and passes it as XPLAT_REF, so a new xplat commit
# invalidates this layer and nothing above it; the default only serves a bare
# `podman build`. The label records which commit went in, since the collection's
# own version (galaxy.yml) never changes. --no-deps is load-bearing: xplat
# declares community.general, and resolving it would put a Galaxy copy in
# /usr/share/ansible/collections that shadows the one in the ansible bundle.
# ansible-galaxy leaves a galaxy_cache and tmp dir in /root/.ansible, which no
# earlier layer creates, so the whole directory goes.
ARG XPLAT_REF=master
LABEL io.github.pdutton.xplat.revision="$XPLAT_REF"
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends git \
 && ansible-galaxy collection install --no-deps \
      -p /usr/share/ansible/collections \
      "git+https://github.com/pdutton/ansible-collection-xplat.git,$XPLAT_REF" \
 && apt-get purge -y --auto-remove git \
 && rm -rf /root/.ansible /var/lib/apt/lists/*

WORKDIR /apps
CMD ["ansible", "--help"]
